{
  "name": "esp_new_jpeg",
  "version": "1.0.2",
  "description": "Pinned Espressif software JPEG decoder for ESP32-S3 video playback",
  "platforms": [
    "espressif32"
  ],
  "build": {
    "includeDir": "include",
    "srcFilter": [
      "-<*>"
    ],
    "flags": [
      "-Llib/esp32s3",
      "-lesp_new_jpeg"
    ]
  }
}
